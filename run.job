#!/bin/bash
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --time=00:40:00
#SBATCH -J lbm_gpu
#SBATCH --mem=6gb
#SBATCH --partition=gpu_a100_il
#SBATCH --gres=gpu:1

module purge
module load toolkit/nvidia-hpc-sdk/25.1
module load mpi/openmpi/5.0-nvidia-25.1-nompi

nvidia-smi

time ./build-gpu/executables/main 300 300
