# Build directories
build/
build-*/
debug/
cmake-build-*/
cmake_packages/

# CMake / Kokkos FetchContent cache
_deps/
CMakeCache.txt
CMakeFiles/

# Compiled objects / binaries
*.o
*.obj
*.a
*.so

# Raw per-timestep simulation dumps (regenerate via `main`/`milestoneNN` — see each executables/0N/README.md)
executables/*/Outputs/
executables/*/Outputs_*/
executables/*/run_*/

# Python cache
__pycache__/
*.pyc

# Windows zone-identifier metadata (leftover from downloaded files)
*Zone.Identifier*

# Editor/OS junk
.DS_Store
.idea/
.vscode/
